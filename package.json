{
  "name": "paper_amigo",
  "version": "0.5.0",
  "type": "module",
  "private": true,
  "bin": {
    "paper-amigo": "./cli/paper-amigo.ts"
  },
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": ">=20.16.0"
  },
  "overrides": {
    "effect": "3.20.0",
    "undici": "^7.30.2",
    "source-map-js": "^1.2.2"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "cli": "bun run ./cli/paper-amigo.ts",
    "cli:build": "bun build ./cli/paper-amigo.ts --compile --outfile ./dist/paper-amigo",
    "lint": "bun run lint:oxlint && bun run lint:eslint",
    "lint:oxlint": "oxlint .",
    "lint:eslint": "eslint . --max-warnings=0",
    "lint:fix": "oxlint . --fix && eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "bun run test:app && bun run test:convex",
    "test:app": "vitest run",
    "test:convex": "vitest run --config vitest.convex.config.mts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "audit": "bun audit --production",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test",
    "ci": "bun run check && bun run audit && bun run build && bun run cli:build",
    "prepare": "husky"
  },
  "dependencies": {
    "@uploadthing/react": "^7.3.3",
    "better-auth": "^1.7.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "convex": "^1.49.0",
    "lucide-react": "^1.70.0",
    "next": "16.4.5",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "6.5.438",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "uploadthing": "^7.7.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@edge-runtime/vm": "^5.0.0",
    "@oxlint/plugins": "1.93.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "convex-test": "^0.0.67",
    "eslint": "^10.14.0",
    "eslint-config-next": "16.4.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-oxlint": "1.93.0",
    "husky": "9.1.7",
    "jsdom": "31.0.0",
    "lint-staged": "17.6.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2006",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0",
    "shadcn": "^4.23.0"
  }
}
