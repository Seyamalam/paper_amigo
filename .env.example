# Local-only escape hatch. Vercel always fails closed without auth variables.
PAPER_AMIGO_DEMO_MODE=true

# Single owner credential + encrypted stateless session
BETTER_AUTH_SECRET=
PAPER_AMIGO_OWNER_EMAIL=owner@example.com
PAPER_AMIGO_OWNER_PASSWORD=

# Private PDF storage
UPLOADTHING_TOKEN=

# CLI-only bearer credential
PAPER_AMIGO_INGESTION_TOKEN=

# Added after the managed KV provider is selected
KV_REST_API_URL=
KV_REST_API_TOKEN=
