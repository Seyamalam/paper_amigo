# Local-only escape hatch. Vercel always fails closed without auth variables.
PAPER_AMIGO_DEMO_MODE=true

# Single owner credential + encrypted stateless session
BETTER_AUTH_SECRET=
PAPER_AMIGO_OWNER_EMAIL=owner@example.com
PAPER_AMIGO_OWNER_PASSWORD=

# Convex structured data. The server-only cloud URL is sufficient.
CONVEX_URL=
# Optional. If omitted, the server derives this from BETTER_AUTH_SECRET.
PAPER_AMIGO_CONVEX_SERVICE_SECRET=

# Public-read PDF storage
UPLOADTHING_TOKEN=

# Local CLI target. Use https://paper-amigo.vercel.app for production.
PAPER_AMIGO_URL=http://localhost:3000
