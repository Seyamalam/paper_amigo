# Local-only escape hatch. Vercel always fails closed without auth variables.
PAPER_AMIGO_DEMO_MODE=true

# Stateless Better Auth + Google OAuth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PAPER_AMIGO_OWNER_EMAILS=owner@example.com,second-owner@example.com

# Private PDF storage
UPLOADTHING_TOKEN=

# CLI-only bearer credential
PAPER_AMIGO_INGESTION_TOKEN=

# Added after the managed KV provider is selected
KV_REST_API_URL=
KV_REST_API_TOKEN=
